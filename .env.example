# Copy to .env at the workspace root:  cp .env.example .env
# Compose reads it via:  docker compose --env-file .env -f infrastructure/docker-compose.yml up -d

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=shortvideo
POSTGRES_SUPERUSER_PASSWORD=shortvideo
POSTGRES_DB=short_video
POSTGRES_APP_USER=short_video_app
POSTGRES_APP_PASSWORD=short_video_app

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:29092

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=short-video

# Local only. Must be >= 32 bytes for HS256. Never commit a real secret.
JWT_SECRET=local-dev-secret-change-me-at-least-32-bytes-long
JWT_ISSUER=short-video-local
JWT_AUDIENCE=short-video-web
JWT_TTL_SECONDS=1800
SESSION_COOKIE_NAME=sv_session
PLAYBACK_COOKIE_TTL_SECONDS=300

MEDIA_STREAM_BUFFER_BYTES=131072
MEDIA_MAX_CONCURRENT_STREAMS=32

WORKER_MAX_CONCURRENT_JOBS=2
WORKER_JOB_TIMEOUT_SECONDS=900

WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
