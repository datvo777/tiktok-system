# Copy to .env at the workspace root:  cp .env.example .env
# Compose reads it via:  docker compose --env-file .env -f infrastructure/docker-compose.yml up -d

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=shortvideo
POSTGRES_SUPERUSER_PASSWORD=shortvideo
POSTGRES_DB=short_video
POSTGRES_APP_USER=short_video_app
POSTGRES_APP_PASSWORD=short_video_app

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:29092

MINIO_ENDPOINT=http://localhost:9000
# Root credentials. Used only by minio-init to create the bucket and mint the
# scoped service account below; the application never sees these.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=short-video
# What the backend and media worker authenticate with: scoped to the one bucket,
# so a compromise of either process cannot touch anything else.
MINIO_APP_ACCESS_KEY=short-video-app
MINIO_APP_SECRET_KEY=short-video-app-secret

# Must be >= 32 random bytes for HS256. There is no default in application.yml:
# the app refuses to start without this, and refuses the placeholder below unless
# the `local` profile is active. Generate a real one: openssl rand -base64 48
# Never commit a real secret.
JWT_SECRET=local-dev-secret-change-me-at-least-32-bytes-long
JWT_ISSUER=short-video-local
JWT_AUDIENCE=short-video-web
JWT_TTL_SECONDS=1800
SESSION_COOKIE_NAME=sv_session
# Drives Secure on both the session and playback cookies. Defaults to true; only
# a plain-HTTP local stack should set it false.
COOKIE_SECURE=false
PLAYBACK_COOKIE_TTL_SECONDS=300

MEDIA_STREAM_BUFFER_BYTES=131072
MEDIA_MAX_CONCURRENT_STREAMS=32

WORKER_MAX_CONCURRENT_JOBS=2
WORKER_JOB_TIMEOUT_SECONDS=900

WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
