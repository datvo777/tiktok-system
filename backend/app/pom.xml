            <artifactId>revocation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shortvideo</groupId>
            <artifactId>upload</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shortvideo</groupId>
            <artifactId>video</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shortvideo</groupId>
            <artifactId>eligibility</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shortvideo</groupId>
            <artifactId>moderation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shortvideo</groupId>
            <artifactId>publication</artifactId>
        </dependency>
        <dependency>
