        </dependency>
        <dependency>
            <groupId>com.shortvideo</groupId>
            <artifactId>inbox</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shortvideo</groupId>
            <artifactId>outbox</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shortvideo</groupId>
            <artifactId>security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shortvideo</groupId>
            <artifactId>observability</artifactId>
        </dependency>
        <dependency>
